# Example ENV file for the Basecamp Dashboard project. Copy this file to .env and fill in the required values.
# can do this cp .env.example .env

DATABASE_URL=postgresql://basecamp:basecamp@localhost:5432/basecamp
# Generate a local secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Optional development-only guild snowflake for command registration. Production can omit it.
# DISCORD_DEVELOPMENT_GUILD_ID=
# Used by Better Auth to verify guild membership during OAuth sign-in and account linking.
DISCORD_GUILD_ID=408711970305474560
# Comma-separated Discord IDs allowed to bootstrap the first Team Admin.
BASECAMP_BOOTSTRAP_ADMIN_DISCORD_IDS=
BASECAMP_TIME_ZONE=America/New_York
# Optional: generate with `openssl rand -base64 32`; required to save a bot token in the portal.
# BOT_SETTINGS_ENCRYPTION_KEY=

# At least 20 random bytes encoded as Base32; keep this shared with the facility display.
ATTENDANCE_TOTP_SECRET=replace-with-a-random-base32-seed
ATTENDANCE_DISPLAY_PASSWORD=choose-a-password-for-the-facility-display
ATTENDANCE_DISPLAY_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: exact dashboard proxy address/CIDR, or `loopback` for a same-host proxy.
# Set only when the dashboard's public ingress strips client-supplied X-Forwarded-For.
# ATTENDANCE_TRUSTED_PROXY=loopback
