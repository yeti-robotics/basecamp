# Example ENV file for the Basecamp Dashboard project. Copy this file to .env and fill in the required values.
# can do this cp .env.example .env

DATABASE_URL=postgresql://basecamp:basecamp@localhost:5432/basecamp
BETTER_AUTH_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_DEVELOPMENT_GUILD_ID=your_discord_development_guild_id
DISCORD_TOKEN=your_discord_bot_token
