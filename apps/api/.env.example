# Example ENV file for the Basecamp Dashboard project. Copy this file to .env and fill in the required values.
# can do this cp .env.example .env

DATABASE_URL=postgresql://basecamp:basecamp@localhost:5432/basecamp
# Generate a local secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_DEVELOPMENT_GUILD_ID=your_discord_development_guild_id
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_TOKEN=your_discord_bot_token

# At least 20 random bytes encoded as Base32; keep this shared with the facility display.
ATTENDANCE_TOTP_SECRET=replace-with-a-random-base32-seed
ATTENDANCE_DISPLAY_PASSWORD=choose-a-password-for-the-facility-display
ATTENDANCE_DISPLAY_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
